# Copy to deploy/.env and fill in values:
#   cp deploy/env.example deploy/.env
#
# Postgres (docker-compose service name: postgres)
POSTGRES_DB=goldbot
POSTGRES_USER=goldbot
POSTGRES_PASSWORD=changeme

# Backend — use hostnames `postgres` and `redis` inside Docker network
DATABASE_URL=postgresql+asyncpg://goldbot:changeme@postgres:5432/goldbot
DATABASE_URL_SYNC=postgresql://goldbot:changeme@postgres:5432/goldbot
REDIS_URL=redis://redis:6379/0

# API — must match how browsers reach your VPS (IP or domain + port)
BACKEND_HOST_PORT=8080
# Published port is the nginx gateway (UI + /api + /ws); Next.js is internal only.
FRONTEND_HOST_PORT=3000

# Frontend build-time — NEXT_PUBLIC_* optional: the UI uses same-origin /api proxy (see next.config rewrites).
# BACKEND_INTERNAL_URL is the FastAPI URL from inside the frontend container (docker-compose default is fine).
# For a reverse proxy / custom backend port, set NEXT_PUBLIC_BACKEND_PORT (WebSocket) and BACKEND_INTERNAL_URL at build.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Production: omit NEXT_PUBLIC_WS_URL (or leave empty). Do not set ws://YOUR_IP:8080 — browser must use ws(s)://<same host:port as UI>/ws.
# NEXT_PUBLIC_WS_URL=wss://api.otherdomain.com/ws
# BACKEND_INTERNAL_URL=http://backend:8080

# CORS — comma-separated origins; include your UI origin (http://IP:3000 or https://domain)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MT5 Bridge (Windows VPS) — required for live trading
MT5_BRIDGE_URL=http://YOUR_MT5_BRIDGE_HOST:8080
MT5_BRIDGE_API_KEY=

# Kimi / Moonshot
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.ai/v1

# App secrets (generate strong values)
SECRET_KEY=
VAULT_MASTER_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Copy other keys from backend/.env.example as needed (SYMBOL, TIMEFRAME, ROLLOUT_MODE, etc.)
